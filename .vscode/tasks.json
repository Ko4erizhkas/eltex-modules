{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "tests: 2.1 phoneBook",
            "type": "shell",
            "command": "make test",
            "options": {
                "cwd": "${workspaceFolder}/module2/2/2.1/tests"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": [
                "$gcc",
                {
                    "owner": "unity",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}/module2/2/2.1/tests"
                    ],
                    "pattern": {
                        "regexp": "^(.*\\.c):(\\d+):([^:]+):(FAIL|IGNORE):?\\s*(.*)$",
                        "file": 1,
                        "line": 2,
                        "severity": 4,
                        "message": 5
                    }
                }
            ]
        },
        {
            "label": "tests: 2.1 phoneBook (clean)",
            "type": "shell",
            "command": "make clean",
            "options": {
                "cwd": "${workspaceFolder}/module2/2/2.1/tests"
            },
            "problemMatcher": []
        }
    ]
}
